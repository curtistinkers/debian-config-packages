#!/bin/sh
set -e

PACKAGE_NAME="debian-config-server-hardening"
SCRIPT_NAME="postrm"

# --- Helper Functions ---

reload_sysctl() {
    if command -v sysctl >/dev/null 2>&1; then
        sysctl --system >/dev/null 2>&1 || true
    fi
}

trigger_systemd_reload() {
    if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
        systemctl --system daemon-reload >/dev/null 2>&1 || true
    fi
}

restart_mount_unit() {
    _unit="$1"
    if [ -d /run/systemd/system ] && command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke restart "${_unit}" || true
    fi
}

remove_proc_fstab_entry() {
    if [ -f /etc/fstab ]; then
        sed -i "/# Added by ${PACKAGE_NAME} for hidepid/d" /etc/fstab
        sed -i '\|^proc /proc proc|d' /etc/fstab
    fi
}

remount_proc_default() {
    if [ -d /run/systemd/system ]; then
        mount -o remount,defaults,hidepid=0 /proc || true
    fi
}

# --- Main Logic Execution ---

case "$1" in
    remove)
        reload_sysctl
    ;;

    purge)
        remove_proc_fstab_entry

        trigger_systemd_reload

        restart_mount_unit "tmp.mount"
        remount_proc_default

        reload_sysctl
    ;;
    
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
	;;

    *)
        ARG="${1:-none}"
        echo "${PACKAGE_NAME}: ${SCRIPT_NAME} called with unknown argument \`${ARG}\`" >&2
        exit 1
    ;;
		
esac

# Automatically injects standard debhelper maintenance routines
#DEBHELPER#

exit 0
