#!/bin/sh
set -e

PACKAGE_NAME="debian-config-server-hardening"
SCRIPT_NAME="postinst"

# --- Helper Functions ---

disable_service_daemons() {
    # Services to disable
    _services="exim4 cups avahi-daemon"

    # Disable and stop services via deb-systemd-invoke and deb-systemd-helper
    for service in ${_services}; do
        if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
            echo "${PACKAGE_NAME}: Searching for ${service}.service"
            if systemctl list-unit-files "${service}.service" >/dev/null 2>&1; then
                if command -v deb-systemd-helper >/dev/null 2>&1; then
                    echo "${PACKAGE_NAME}: Disabling ${service}.service"
                    deb-systemd-helper disable "${service}.service" || true
                fi

                # Only invoke a stop if the service is actively running
                if systemctl is-active --quiet "${service}.service"; then
                    if command -v deb-systemd-invoke >/dev/null 2>&1; then
                        echo "${PACKAGE_NAME}: Stopping ${service}.service"
                        deb-systemd-invoke stop "${service}" || true
                    fi
                fi
            fi
        fi
    done
}

set_default_target() {
    # Check if systemd environment exists and default.target isn't already multi-user
    if [ -d /etc/systemd/system ]; then
        CURRENT_TARGET=$(readlink /etc/systemd/system/default.target || echo "")
        if [ "${CURRENT_TARGET}" != "/lib/systemd/system/multi-user.target" ] && \
           [ "${CURRENT_TARGET}" != "/usr/lib/systemd/system/multi-user.target" ]; then
            ln -sf /lib/systemd/system/multi-user.target /etc/systemd/system/default.target
        fi
    fi
}

apply_sysctl_settings() {
    if command -v sysctl >/dev/null 2>&1; then
        sysctl --system >/dev/null 2>&1 || true
    fi
}

trigger_systemd_reload() {
    if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
        systemctl --system daemon-reload >/dev/null 2>&1 || true
    fi
}

restart_mount_unit() {
    _unit="$1"
    if [ -d /run/systemd/system ] && command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke restart "${_unit}" || true
    fi
}

fstab_proc_entry_exists() {
    grep -qE '^[[:space:]]*[^#].*[[:space:]]+/proc[[:space:]]' /etc/fstab
}

_proc_mount_options="defaults,relatime,nosuid,nodev,noexec,hidepid=2"

add_proc_fstab_entry() {
    _proc_fstab_line="proc /proc proc ${_proc_mount_options} 0 0"
    if ! fstab_proc_entry_exists; then
        echo "Adding hardened /proc entry to /etc/fstab..."
        {
            echo ""
            echo "# Added by ${PACKAGE_NAME} for hidepid"
            echo "${_proc_fstab_line}"
        } >> /etc/fstab
    else
        echo "/proc entry already exists in /etc/fstab."
    fi
}

remount_proc() {
    if [ -d /run/systemd/system ]; then
        mount -o remount,"${_proc_mount_options}" /proc || true
    fi
}

# --- Main Logic Execution ---

case "$1" in
    configure)
        disable_service_daemons
        set_default_target

        add_proc_fstab_entry

        trigger_systemd_reload
        
        restart_mount_unit "tmp.mount"

        remount_proc
        
        apply_sysctl_settings
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        ARG="${1:-none}"
        echo "${PACKAGE_NAME}: ${SCRIPT_NAME} called with unknown argument \`${ARG}\`" >&2
        exit 1
        ;;

esac

# Automatically injects standard debhelper maintenance routines
#DEBHELPER#

exit 0
