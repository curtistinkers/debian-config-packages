#!/bin/sh
set -e

PACKAGE_NAME="debian-config-server-hardening"
SCRIPT_NAME="postinst"

# --- Helper Functions ---

disable_server_daemons() {
    # Disable and stop services via invoke-rc.d and deb-systemd-helper
    for service in exim4 cups avahi-daemon; do
        # Mask/disable the systemd unit persistently across reboots
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper disable "${service}.service" || true
        fi

        # Safely stop the service respecting runlevels and policy-rc.d
        if command -v invoke-rc.d >/dev/null 2>&1; then
            invoke-rc.d "${service}" stop || true
        fi
    done
}

set_default_target() {
    # Check if systemd is actively running as PID 1
    if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
        CURRENT_TARGET=$(systemctl get-default 2>/dev/null || true)
        if [ "${CURRENT_TARGET}" != "multi-user.target" ]; then
            systemctl set-default multi-user.target || true
        fi
    fi
}

apply_sysctl_settings() {
    if command -v sysctl >/dev/null 2>&1; then
        sysctl --system >/dev/null 2>&1 || true
    fi
}

configure_fstab_mount() {
    _target="$1"
    _fstype="$2"
    _options="$3"
    _file="/etc/fstab"

    if grep -qE "^[[:space:]]*[^#].*[[:space:]]${_target}[[:space:]]" "${_file}"; then
        sed -i "s@^[[:space:]]*\([^#][^[:space:]]*[[:space:]]\+${_target}[[:space:]]\+[^[:space:]]*[[:space:]]\+\)[^[:space:]]*@\1${_options}@" "${_file}"
    else
        printf "%s\t%s\t%s\t%s\t0\t0\n" "${_fstype}" "${_target}" "${_fstype}" "${_options}" >> "${_file}"
    fi
}

configure_proc_entry() {
    _file="/etc/fstab"
    if ! grep -qE "^[[:space:]]*[^#].*[[:space:]]/proc[[:space:]]" "${_file}"; then
        printf "proc\t/proc\tproc\tdefaults,hidepid=2\t0\t0\n" >> "${_file}"
    fi
}

apply_mount_remount() {
    _target="$1"
    _options="$2"
    if [ -d "${_target}" ] || [ "${_target}" = "/proc" ]; then
        if [ -n "${_options}" ]; then
            mount -o remount,${_options} "${_target}" || true
        else
            mount -o remount "${_target}" || true
        fi
    fi
}

# --- Main Logic Execution ---

case "$1" in
    configure)
        disable_server_daemons
        set_default_target

        configure_fstab_mount "/tmp" "tmpfs" "defaults,noexec,nosuid,nodev"
        configure_fstab_mount "/dev/shm" "tmpfs" "defaults,noexec,nosuid,nodev"
        configure_proc_entry
        apply_mount_remount "/tmp"
        apply_mount_remount "/dev/shm"
        apply_mount_remount "/proc" "hidepid=2"
        
        apply_sysctl_settings
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        ARG="${1:-none}"
        echo "${PACKAGE_NAME}: ${SCRIPT_NAME} called with unknown argument \`${ARG}\`" >&2
        exit 1
        ;;

esac

# Automatically injects standard debhelper maintenance routines
#DEBHELPER#

exit 0
