#!/bin/sh
set -e

PACKAGE_NAME="debian-config-server-hardening"
SCRIPT_NAME="postinst"

# --- Helper Functions ---

disable_server_daemons() {
    # Disable and stop services via invoke-rc.d and deb-systemd-helper
    for service in exim4 cups avahi-daemon; do
        # Mask/disable the systemd unit persistently across reboots
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper disable "${service}.service" || true
        fi

        # Safely stop the service respecting runlevels and policy-rc.d
        if command -v invoke-rc.d >/dev/null 2>&1; then
            invoke-rc.d "${service}" stop || true
        fi
    done
}

set_default_target() {
    # Check if systemd environment exists and default.target isn't already multi-user
    if [ -d /etc/systemd/system ]; then
        CURRENT_TARGET=$(readlink /etc/systemd/system/default.target || echo "")
        if [ "${CURRENT_TARGET}" != "/lib/systemd/system/multi-user.target" ] && \
           [ "${CURRENT_TARGET}" != "/usr/lib/systemd/system/multi-user.target" ]; then
            ln -sf /lib/systemd/system/multi-user.target /etc/systemd/system/default.target
        fi
    fi
}

apply_sysctl_settings() {
    if command -v sysctl >/dev/null 2>&1; then
        sysctl --system >/dev/null 2>&1 || true
    fi
}

trigger_systemd_reload() {
    if [ -d /run/systemd/system ] && command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke daemon-reload || true
    fi
}

restart_mount_unit() {
    _unit="$1"
    if [ -d /run/systemd/system ] && command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke restart "${_unit}" || true
    fi
}

fstab_dev_entry_exists() {
    grep -qE '^[[:space:]]*[^#].*[[:space:]]+/dev[[:space:]]' /etc/fstab
}

add_dev_fstab_entry() {
    _dev_fstab_line="devtmpfs /dev devtmpfs defaults,noexec 0 0"
    if ! fstab_dev_entry_exists; then
        echo "Adding hardened /dev entry to /etc/fstab..."
        {
            echo ""
            echo "# Added by server-hardening package for /dev"
            echo "${_dev_fstab_line}"
        } >> /etc/fstab
    else
        echo "/dev entry already exists in /etc/fstab."
    fi
}

fstab_dev_shm_entry_exists() {
    grep -qE '^[[:space:]]*[^#].*[[:space:]]+/dev/shm[[:space:]]' /etc/fstab
}

add_dev_shm_fstab_entry() {
    _dev_shm_fstab_line="tmpfs /dev/shm tmpfs defaults,noexec 0 0"
    if ! fstab_dev_shm_entry_exists; then
        echo "Adding hardened /dev/shm entry to /etc/fstab..."
        {
            echo ""
            echo "# Added by server-hardening package"
            echo "${_dev_shm_fstab_line}"
        } >> /etc/fstab
    else
        echo "/dev/shm entry already exists in /etc/fstab."
    fi
}

fstab_proc_entry_exists() {
    grep -qE '^[[:space:]]*[^#].*[[:space:]]+/proc[[:space:]]' /etc/fstab
}

add_proc_fstab_entry() {
    _proc_fstab_line="proc /proc proc defaults,hidepid=2 0 0"
    if ! fstab_proc_entry_exists; then
        echo "Adding hardened /proc entry to /etc/fstab..."
        {
            echo ""
            echo "# Added by server-hardening package for hidepid"
            echo "${_proc_fstab_line}"
        } >> /etc/fstab
    else
        echo "/proc entry already exists in /etc/fstab."
    fi
}

remount_dev() {
    if [ -d /run/systemd/system ]; then
        mount -o remount,defaults,noexec /dev || true
    fi
}

remount_dev_shm() {
    if [ -d /run/systemd/system ]; then
        mount -o remount,defaults,noexec /dev/shm || true
    fi
}

remount_proc() {
    if [ -d /run/systemd/system ]; then
        mount -o remount,defaults,hidepid=2 /proc || true
    fi
}

# --- Main Logic Execution ---

case "$1" in
    configure)
        disable_server_daemons
        set_default_target

        add_dev_fstab_entry
        add_dev_shm_fstab_entry
        add_proc_fstab_entry

        trigger_systemd_reload
        
        restart_mount_unit "tmp.mount"
        remount_dev
        remount_dev_shm
        remount_proc
        
        apply_sysctl_settings
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        ARG="${1:-none}"
        echo "${PACKAGE_NAME}: ${SCRIPT_NAME} called with unknown argument \`${ARG}\`" >&2
        exit 1
        ;;

esac

# Automatically injects standard debhelper maintenance routines
#DEBHELPER#

exit 0
