#########################
# --- CUSTOM GROUPS --- #
#########################

# Define group for regular log files
LogFile       = L+growing+ANF+I

# Define group for directory that strips out link count
VarDirNoLinks = VarDir-n

# Define group for user home directory & files
UserHomeDir   = VarDirNoLinks+ANF
UserHomeFile  = VarFile+ANF+ARF

########################
# --- DEBIAN RULES --- #
########################

# Root Dir rules
# --------------
=/$ d VarTime

# Temporary and runfile rules
# ---------------------------

# Match ONLY the /tmp, /run directories itself
=/(tmp|run)$ d=tmpfs VarDirNoLinks

# Ignore everything inside the /tmp, /run directories
!/(tmp|run)/.* =tmpfs

# Logging rules
# -------------

# Match AIDE logs
/var/log/aide/.*\.log(\.[0-9]+)?$ f LogFile
/var/log/aide/.*\.log\.[0-9]+(\.gz)?$ f VarFile+ANF+I

# Match system event logs
/var/log/unattended-upgrades/unattended-upgrades(-shutdown)?\.log$ LogFile
/var/log/wtmp\.db$ InodeData

# Hardware device rules
# ---------------------

# Ignore volatile character devices (ptys, ttys, and virtual loops)
!/dev/pts/.* =tmpfs
=/dev/char$ d=tmpfs VarDir-i
!/dev/char/(1|5|136):.* =tmpfs

# Monitor hardware changes with a metadata-only rule
/dev/char/.* =tmpfs L

# User home directory rules
# -------------------------

# Monitor users' home folders (new users, deleted users, or changed folder permissions)
=/home/[^/]+$ d VarDirNoLinks

# Track files/folders inside, but ONLY for permissions, types, and new items
/home/[^/]+/.* d UserHomeDir
/home/[^/]+/.* f UserHomeFile

# Strictly monitor SSH keys for tampering (No unauthorized keys allowed)
/home/[^/]+/\.ssh/.*$ Full

# Track critical shell configuration files (Detect unauthorized alias injections)
/home/[^/]+/\.(bashrc|profile|zshrc)$ Full

# Ignore history files that shift constantly during active terminal sessions
!/home/[^/]+/\..*_history$

# Dpkg/APT cache rules
# ---------------

# Protect the root directory itself
=/var/cache/apt$ d VarDir

# Ignore the dynamic binary caches generated by APT
!/var/cache/apt/.*\.bin$

# Ignore the dynamic mirror list metadata and release signatures
!/var/lib/apt/lists/_.*$
!/var/lib/apt/lists/auxfiles/.*$

# Ignore temporary transactional dpkg update files
!/var/lib/dpkg/updates/.*$

# Exim rules
# ----------
=/var/spool/exim4/db$ VarTime
