#!/bin/sh
set -e

PACKAGE_NAME="debian-config-sshd"
SCRIPT_NAME="postrm"

# --- Helper Functions ---

# Inform the sysadmin about the remaining group rather than deleting it:
notify_admin_about_ssh_users_group() {
    if getent group ssh-users >/dev/null; then
        echo "Note: The 'ssh-users' group was left intact to avoid breaking user group memberships." >&2
        echo "To remove it manually, run: delgroup ssh-users" >&2
    fi
}

reload_ssh() {
    if sshd -t >/dev/null 2>&1; then
        if command -v invoke-rc.d >/dev/null 2>&1; then
            invoke-rc.d ssh reload || true
        fi
    fi
}

# --- Main Logic Execution ---

case "$1" in
    purge)
        notify_admin_about_ssh_users_group
        reload_ssh
    ;;

	remove)
        reload_ssh
    ;;
    
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
	;;

    *)
        ARG="${1:-none}"
        echo "${PACKAGE_NAME}: ${SCRIPT_NAME} called with unknown argument \`${ARG}\`" >&2
        exit 1
    ;;
		
esac

# Automatically injects standard debhelper maintenance routines
#DEBHELPER#

exit 0
