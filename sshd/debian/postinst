#!/bin/sh
set -e

PACKAGE_NAME="debian-config-sshd"
SCRIPT_NAME="postinst"

# --- Helper Functions ---

add_ssh_users_group() {
if ! getent group ssh-users >/dev/null; then
        addgroup --system ssh-users
    fi
}

reload_ssh() {
    if sshd -t; then
        # Safely reload SSH via invoke-rc.d
        if command -v invoke-rc.d >/dev/null 2>&1; then
            invoke-rc.d ssh reload || true
        fi
    else
        echo "WARNING: Invalid SSH configuration! Service not reloaded." >&2
    fi
}

reload_fail2ban() {
    # Reload fail2ban if the service is running
    if command -v invoke-rc.d >/dev/null 2>&1; then
        invoke-rc.d fail2ban reload || true
    fi
}

# --- Main Logic Execution ---

case "$1" in
    configure)
        add_ssh_users_group
        reload_ssh
        reload_fail2ban
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        ARG="${1:-none}"
        echo "${PACKAGE_NAME}: ${SCRIPT_NAME} called with unknown argument \`${ARG}\`" >&2
        exit 1
        ;;

esac

# Automatically injects standard debhelper maintenance routines
#DEBHELPER#

exit 0
