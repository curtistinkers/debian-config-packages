#!/bin/sh
set -e

PACKAGE_NAME="debian-config-system-hardening"
SCRIPT_NAME="postrm"

# --- Helper Functions ---

reload_sysctl() {
    if command -v sysctl >/dev/null 2>&1; then
        sysctl --system >/dev/null 2>&1 || true
    fi
}

remove_pwquality_config() {
    if command -v pam-auth-update >/dev/null 2>&1; then
        pam-auth-update --package --remove system-hardening-pwquality || true
    fi
}

remove_faillock_config() {
    if command -v pam-auth-update >/dev/null 2>&1; then
        pam-auth-update --package --remove system-hardening-faillock || true
    fi
}

remove_statoverride() {
    _target_path="$1"

    if dpkg-statoverride --list "${_target_path}" >/dev/null 2>&1; then
        dpkg-statoverride --remove "${_target_path}" || true
    fi
}

revert_file_permissions() {
    remove_statoverride "/boot/grub/grub.cfg"
    remove_statoverride "/etc/crontab"
    remove_statoverride "/etc/cron.d"
    remove_statoverride "/etc/cron.daily"
    remove_statoverride "/etc/cron.hourly"
    remove_statoverride "/etc/cron.weekly"
    remove_statoverride "/etc/cron.monthly"
    remove_statoverride "/etc/ssh/sshd_config"
}

reload_systemd_daemon() {
    # Apply changes immediately via systemd unit restart or dynamic remount
    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload || true
    fi
}

apply_mount_remount() {
    _target="$1"
    if [ -d "${_target}" ]; then
        mount -o remount "${_target}" || true
    fi
}

# --- Main Logic Execution ---

case "$1" in
    remove)
        # Package removal: clean up PAM profiles and statoverrides, 
        # but leave persistent system configuration (/etc/fstab) intact.
        remove_pwquality_config
        remove_faillock_config
        revert_file_permissions
        reload_sysctl
    ;;

    purge)
        # Package purge: clean up everything, including reverting fstab configurations.
        remove_pwquality_config
        remove_faillock_config
        revert_file_permissions

        reload_systemd_daemon
        apply_mount_remount "/tmp"
        apply_mount_remount "/dev/shm"

        reload_sysctl
    ;;
    
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
	;;

    *)
        ARG="${1:-none}"
        echo "${PACKAGE_NAME}: ${SCRIPT_NAME} called with unknown argument \`${ARG}\`" >&2
        exit 1
    ;;

esac

# Automatically injects standard debhelper maintenance routines
#DEBHELPER#

exit 0
