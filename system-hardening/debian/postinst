#!/bin/sh
set -e

PACKAGE_NAME="debian-config-system-hardening"
SCRIPT_NAME="postinst"

# --- Helper Functions ---

apply_sysctl_settings() {
    if command -v sysctl >/dev/null 2>&1; then
        sysctl --system >/dev/null 2>&1 || true
    fi
}

set_config_key() {
    KEY="$1"
    VALUE="$2"
    FILE="$3"

    # Check if the key exists (commented or uncommented)
    if grep -qE "^#? *${KEY}" "$FILE"; then
        # Update the existing entry
        sed -i "s/^#* *${KEY}.*/${KEY} ${VALUE}/" "$FILE"
    else
        # Append the key if missing entirely
        echo "${KEY} ${VALUE}" >> "$FILE"
    fi
}

apply_login_defs_hardening() {
    LOGIN_DEFS="/etc/login.defs"
    if [ -f "${LOGIN_DEFS}" ]; then
        # Check and set/append each key safely
        set_config_key "SHA_CRYPT_MIN_ROUNDS" "50000" "$LOGIN_DEFS"
        set_config_key "SHA_CRYPT_MAX_ROUNDS" "50000" "$LOGIN_DEFS"
        set_config_key "UMASK"                "027"   "$LOGIN_DEFS"
        set_config_key "PASS_MAX_DAYS"        "90"    "$LOGIN_DEFS"
        set_config_key "PASS_MIN_DAYS"        "7"     "$LOGIN_DEFS"
    fi
}

# --- Main Logic Execution ---

case "$1" in
    configure)
        apply_login_defs_hardening
        apply_sysctl_settings
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        ARG="${1:-none}"
        echo "${PACKAGE_NAME}: ${SCRIPT_NAME} called with unknown argument \`${ARG}\`" >&2
        exit 1
        ;;

esac

# Automatically injects standard debhelper maintenance routines
#DEBHELPER#

exit 0
