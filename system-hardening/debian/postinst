#!/bin/sh
set -e

PACKAGE_NAME="debian-config-system-hardening"
SCRIPT_NAME="postinst"

# --- Helper Functions ---

apply_sysctl_settings() {
    if command -v sysctl >/dev/null 2>&1; then
        sysctl --system >/dev/null 2>&1 || true
    fi
}

apply_pam_pwquality_hardening() {
    if command -v pam-auth-update >/dev/null 2>&1; then
        pam-auth-update --package --enable password-quality || true
    fi
}

apply_pam_faillock_hardening() {
    if command -v pam-auth-update >/dev/null 2>&1; then
        pam-auth-update --package --enable faillock-actions faillock-preauth || true
    fi
}

set_config_key() {
    _key="$1"
    _value="$2"
    _file="$3"

    # Match key even if commented out or at end of line
    if grep -qE "^[[:space:]]*#?[[:space:]]*${_key}([[:space:]]+|$)" "${_file}"; then
        # Update existing line (handles trailing whitespace or direct end-of-line)
        sed -i -E "s@^[[:space:]]*#?[[:space:]]*${_key}([[:space:]].*)?\$@${_key}\t${_value}@" "${_file}"
    else
        # Append missing key
        printf "%s\t%s\n" "${_key}" "${_value}" >> "${_file}"
    fi
}

apply_login_defs_hardening() {
    _login_defs="/etc/login.defs"
    if [ -f "${_login_defs}" ]; then
        # Check and set/append each key safely
        set_config_key "UMASK"                  "027"       "${_login_defs}"
        set_config_key "FAILLOG_ENAB"           "yes"       "${_login_defs}"
        set_config_key "ENCRYPT_METHOD"         "YESCRYPT"  "${_login_defs}"
        set_config_key "YESCRYPT_COST_FACTOR"   "6"         "${_login_defs}"
        # YESCRYPT is the new preferred encryption method
        #set_config_key "ENCRYPT_METHOD"         "SHA512"    "${_login_defs}"
        #set_config_key "SHA_CRYPT_MAX_ROUNDS"   "50000"     "${_login_defs}"
        #set_config_key "SHA_CRYPT_MIN_ROUNDS"   "50000"     "${_login_defs}"
    fi
}

# Helper function to safely apply file/directory permissions
enforce_statoverride() {
    _target_path="$1"
    _mode="$2"
    _user="$3"
    _group="$4"

    if [ -e "${_target_path}" ]; then
        if ! dpkg-statoverride --list "${_target_path}" >/dev/null 2>&1; then
            dpkg-statoverride --update --add "${_user}" "${_group}" "${_mode}" "${_target_path}" || true
        fi
    fi
}

apply_file_hardening_permissions() {
    # GRUB configuration
    enforce_statoverride "/boot/grub/grub.cfg" "0600" "root" "root"

    # Cron system permissions
    enforce_statoverride "/etc/crontab" "0600" "root" "root"
    enforce_statoverride "/etc/cron.d" "0700" "root" "root"
    enforce_statoverride "/etc/cron.daily" "0700" "root" "root"
    enforce_statoverride "/etc/cron.hourly" "0700" "root" "root"
    enforce_statoverride "/etc/cron.weekly" "0700" "root" "root"
    enforce_statoverride "/etc/cron.monthly" "0700" "root" "root"

    # SSH config file (if present)
    enforce_statoverride "/etc/ssh/sshd_config" "0600" "root" "root"
}

trigger_systemd_reload() {
    if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
        systemctl --system daemon-reload >/dev/null 2>&1 || true
    fi
}

fstab_dev_entry_exists() {
    grep -qE '^[[:space:]]*[^#].*[[:space:]]+/dev[[:space:]]' /etc/fstab
}

_dev_mount_options="defaults,mode=755,relatime,nosuid,noexec"

add_dev_fstab_entry() {
    _dev_fstab_line="devtmpfs /dev devtmpfs ${_dev_mount_options} 0 0"
    if ! fstab_dev_entry_exists; then
        echo "${PACKAGE_NAME}: Adding hardened /dev entry to /etc/fstab..."
        {
            echo ""
            echo "# Added by ${PACKAGE_NAME} for /dev"
            echo "${_dev_fstab_line}"
        } >> /etc/fstab
    else
        echo "${PACKAGE_NAME}: /dev entry already exists in /etc/fstab."
    fi
}

remount_dev() {
    if [ -d /run/systemd/system ]; then
        mount -o remount,"${_dev_mount_options}" /dev || true
    fi
}

fstab_dev_shm_entry_exists() {
    grep -qE '^[[:space:]]*[^#].*[[:space:]]+/dev/shm[[:space:]]' /etc/fstab
}

_dev_shm_mount_options="defaults,mode=1777,strictatime,nosuid,nodev,noexec"

add_dev_shm_fstab_entry() {
    _dev_shm_fstab_line="tmpfs /dev/shm tmpfs ${_dev_shm_mount_options} 0 0"
    if ! fstab_dev_shm_entry_exists; then
        echo "${PACKAGE_NAME}: Adding hardened /dev/shm entry to /etc/fstab..."
        {
            echo ""
            echo "# Added by ${PACKAGE_NAME} for /dev/shm"
            echo "${_dev_shm_fstab_line}"
        } >> /etc/fstab
    else
        echo "${PACKAGE_NAME}: /dev/shm entry already exists in /etc/fstab."
    fi
}

remount_dev_shm() {
    if [ -d /run/systemd/system ]; then
        mount -o remount,"${_dev_shm_mount_options}" /dev/shm || true
    fi
}

# --- Main Logic Execution ---

case "$1" in
    configure)
        apply_login_defs_hardening
        apply_pam_pwquality_hardening
        apply_pam_faillock_hardening

        apply_file_hardening_permissions

        add_dev_fstab_entry
        add_dev_shm_fstab_entry

        trigger_systemd_reload

        remount_dev
        remount_dev_shm

        apply_sysctl_settings
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        ARG="${1:-none}"
        echo "${PACKAGE_NAME}: ${SCRIPT_NAME} called with unknown argument \`${ARG}\`" >&2
        exit 1
        ;;

esac

# Automatically injects standard debhelper maintenance routines
#DEBHELPER#

exit 0
