#!/bin/sh
set -e

PACKAGE_NAME="debian-config-system-hardening"
SCRIPT_NAME="postinst"

# --- Helper Functions ---

apply_sysctl_settings() {
    if command -v sysctl >/dev/null 2>&1; then
        sysctl --system >/dev/null 2>&1 || true
    fi
}

apply_pwquality_config() {
    if command -v pam-auth-update >/dev/null 2>&1; then
        pam-auth-update --package --enable system-hardening-pwquality || true
    fi
}

apply_faillock_config() {
    if command -v pam-auth-update >/dev/null 2>&1; then
        pam-auth-update --package --enable system-hardening-faillock || true
    fi
}

set_config_key() {
    _key="$1"
    _value="$2"
    _file="$3"

    # Match key even if commented out or at end of line
    if grep -qE "^[[:space:]]*#?[[:space:]]*${_key}([[:space:]]+|$)" "${_file}"; then
        # Update existing line (handles trailing whitespace or direct end-of-line)
        sed -i -E "s@^[[:space:]]*#?[[:space:]]*${_key}([[:space:]].*)?\$@${_key}\t${_value}@" "${_file}"
    else
        # Append missing key
        printf "%s\t%s\n" "${_key}" "${_value}" >> "${_file}"
    fi
}

apply_login_defs_hardening() {
    _login_defs="/etc/login.defs"
    if [ -f "${_login_defs}" ]; then
        # Check and set/append each key safely
        set_config_key "SHA_CRYPT_MIN_ROUNDS" "50000" "${_login_defs}"
        set_config_key "SHA_CRYPT_MAX_ROUNDS" "50000" "${_login_defs}"
        set_config_key "UMASK"                "027"   "${_login_defs}"
    fi
}

# Helper function to safely apply file/directory permissions
enforce_statoverride() {
    _target_path="$1"
    _mode="$2"
    _user="$3"
    _group="$4"

    if [ -e "${_target_path}" ]; then
        if ! dpkg-statoverride --list "${_target_path}" >/dev/null 2>&1; then
            dpkg-statoverride --update --add "${_user}" "${_group}" "${_mode}" "${_target_path}" || true
        fi
    fi
}

apply_file_hardening_permissions() {
    # GRUB configuration
    enforce_statoverride "/boot/grub/grub.cfg" "0600" "root" "root"

    # Cron system permissions
    enforce_statoverride "/etc/crontab" "0600" "root" "root"
    enforce_statoverride "/etc/cron.d" "0700" "root" "root"
    enforce_statoverride "/etc/cron.daily" "0700" "root" "root"
    enforce_statoverride "/etc/cron.hourly" "0700" "root" "root"
    enforce_statoverride "/etc/cron.weekly" "0700" "root" "root"
    enforce_statoverride "/etc/cron.monthly" "0700" "root" "root"

    # SSH config file (if present)
    enforce_statoverride "/etc/ssh/sshd_config" "0600" "root" "root"
}

configure_fstab_mount() {
    _target="$1"
    _fstype="$2"
    _options="$3"
    _file="/etc/fstab"

    if grep -qE "^[[:space:]]*[^#].*[[:space:]]${_target}[[:space:]]" "${_file}"; then
        sed -i "s@^[[:space:]]*\([^#][^[:space:]]*[[:space:]]\+${_target}[[:space:]]\+[^[:space:]]*[[:space:]]\+\)[^[:space:]]*@\1${_options}@" "${_file}"
    else
        printf "%s\t%s\t%s\t%s\t0\t0\n" "${_fstype}" "${_target}" "${_fstype}" "${_options}" >> "${_file}"
    fi
}

apply_mount_remount() {
    _target="$1"
    if [ -d "${_target}" ]; then
        mount -o remount "${_target}" || true
    fi
}

# --- Main Logic Execution ---

case "$1" in
    configure)
        apply_login_defs_hardening
        apply_pwquality_config
        apply_faillock_config

        apply_file_hardening_permissions

        configure_fstab_mount "/tmp" "tmpfs" "defaults,nosuid,nodev"
        configure_fstab_mount "/dev/shm" "tmpfs" "defaults,nosuid,nodev"
        apply_mount_remount "/tmp"
        apply_mount_remount "/dev/shm"

        apply_sysctl_settings
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        ARG="${1:-none}"
        echo "${PACKAGE_NAME}: ${SCRIPT_NAME} called with unknown argument \`${ARG}\`" >&2
        exit 1
        ;;

esac

# Automatically injects standard debhelper maintenance routines
#DEBHELPER#

exit 0
